# ==========================================
# JobAgent AI - Backend Environment Configuration
# ==========================================

# 1. Frontend & CORS Connection (Vercel Frontend URL)
# Set your Vercel frontend URL here (multiple URLs separated by comma):
FRONTEND_URL=https://your-frontend-app.vercel.app,http://localhost:3000,http://localhost:5173
ALLOWED_ORIGINS=*

# 2. Server Port (Render sets this dynamically via $PORT)
PORT=8000

# 3. LLM Provider Configuration (Mistral, Groq, OpenAI, Gemini, Anthropic)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=your_groq_api_key_here
LLM_TEMPERATURE=0.3
LLM_BASE_URL=

# Provider-Specific API Key Aliases (Optional)
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# 4. Embedding Model Configuration (Local vectorizer or Pinecone)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# 5. Cloud Database Connection (Supabase, Neon, Railway, or Render PostgreSQL)
# Example Supabase: postgresql://postgres.xxxx:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/jobs

# 6. Supabase Storage (Optional for resume storage)
SUPABASE_URL=
SUPABASE_KEY=
STORAGE_BUCKET=jobhunt

# 7. Pinecone Vector DB (Optional Cloud Index)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=jobhunt

# 8. Email Notification Service (Gmail SMTP for Auto Alerts)
EMAIL_FROM=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# 9. Static Superadmin Access
ADMIN_EMAIL=
ADMIN_PS=
JWT_SECRET=

# 10. Job Board API Tokens (Optional)
FREEHIRE_TOKEN=
RAPIDAPI_KEY=

# 11. LinkedIn & HR Contact Enrichment (Optional - Scout Engine)
# Get li_at cookie from browser DevTools > Application > Cookies > .linkedin.com > li_at
# Without cookie, the system uses autonomous search engine dorking (works out-of-the-box)
LINKEDIN_COOKIE=
